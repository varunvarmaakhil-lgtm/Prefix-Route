# Cluster settings. `bash cluster/probe.sh` prints what is needed; `cluster/autoconf.sh` fills the Slurm
# fields from sinfo/sacctmgr automatically. Sourced by every cluster script.
export PR_ROOT="${PR_ROOT:-$HOME/prefixroute}"          # code + data + results (this repo)
export VENV_DIR="${VENV_DIR:-$PR_ROOT/venv}"
export MODELS_DIR="${MODELS_DIR:-$PR_ROOT/models}"
export HF_HOME="${HF_HOME:-$MODELS_DIR/.hf_home}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/${USER}-uvcache}"   # off the 50 GB quota; removed after setup
export LOCK_FILE="${LOCK_FILE:-requirements.lock}"           # requirements-cu13.lock if driver >= 580
[[ -f "$PR_ROOT/cluster/slurm.env" ]] && source "$PR_ROOT/cluster/slurm.env"   # written by autoconf.sh
export SLURM_ACCOUNT="${SLURM_ACCOUNT:-}"
export SLURM_GPU_PARTITION="${SLURM_GPU_PARTITION:-}"
export SLURM_CPU_PARTITION="${SLURM_CPU_PARTITION:-}"
export GPU_GRES="${GPU_GRES:-gpu:a100_4g.20gb:1}"  # all full A100s were held for weeks (2026-09-25); 4g.20gb MIG slice
export MEASURE_CPUS="${MEASURE_CPUS:-8}"
export SIM_CPUS="${SIM_CPUS:-24}"
export MEASURE_BUDGET_MIN="${MEASURE_BUDGET_MIN:-235}"   # hard cap for the GPU phase (handoff: <= 4 h)
